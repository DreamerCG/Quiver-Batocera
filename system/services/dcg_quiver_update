#!/bin/bash
# Vérifie la version Quiver au démarrage et installe les mises à jour.

REPO_RAW="https://raw.githubusercontent.com/DreamerCG/Quiver-Batocera/main"
VERSION_FILE="/userdata/system/Quiver/VERSION"
LAUNCHER_UPDATER="/userdata/system/Quiver/bin/quiver-update-launcher"
LOG="/userdata/system/logs/quiver_update.log"
BATOCERA_CONF="/userdata/system/batocera.conf"

log() { echo "$(date '+%F %T') $*" >> "$LOG"; }

version_gt() {
    [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -n1)" = "$1" ]
}

check_update() (
    local remote="" local_v install_dir run_mode="${1:-interactive}"
    set -o pipefail

    run_logged() {
        if [ "$run_mode" = background ]; then
            "$@" 2>&1
        else
            "$@" 2>&1 | tee -a "$LOG"
        fi
    }

    if ! touch "$BATOCERA_CONF"; then
        log "ERREUR : impossible de créer $BATOCERA_CONF"
        echo "Configuration impossible : consulte $LOG"
        return 1
    fi
    if [ -n "$(tail -c1 "$BATOCERA_CONF")" ]; then
        if ! echo >> "$BATOCERA_CONF"; then
            log "ERREUR : impossible d'écrire dans $BATOCERA_CONF"
            return 1
        fi
    fi
    local setting key pattern
    for setting in 'quiver.emulator=quiver' 'quiver.bezel=none' 'quiver.LAUNCHER_QUIVER=off'; do
        key="${setting%%=*}"
        pattern="${key//./\\.}"
        if grep -q "^${pattern}=" "$BATOCERA_CONF"; then
            if ! sed -i "s|^${pattern}=.*|${setting}|" "$BATOCERA_CONF"; then
                log "ERREUR : impossible de modifier $key"
                return 1
            fi
        elif ! echo "$setting" >> "$BATOCERA_CONF"; then
            log "ERREUR : impossible d'ajouter $key"
            return 1
        fi
    done

    if command -v curl >/dev/null 2>&1; then
        download_version() { curl -fsSL --max-time 5 "$REPO_RAW/VERSION"; }
        download_installer() { curl -fsSL --retry 3 --connect-timeout 15 "$REPO_RAW/install.sh" -o "$1"; }
    elif command -v wget >/dev/null 2>&1; then
        download_version() { wget -q -T 5 -O - "$REPO_RAW/VERSION"; }
        download_installer() { wget -q -t 3 -T 30 -O "$1" "$REPO_RAW/install.sh"; }
    else
        log "ERREUR : curl ou wget est nécessaire"
        echo "Mise à jour impossible : curl ou wget est nécessaire."
        return 1
    fi

    echo "Vérification de la version distante..."
    for ((attempt=1; attempt<=30; attempt++)); do
        if remote="$(download_version)"; then
            remote="$(printf '%s' "$remote" | tr -d '\r\n[:space:]')"
            [ -n "$remote" ] && break
        else
            remote=""
        fi
        [ "$attempt" -eq 30 ] || sleep 2
    done
    if [ -z "$remote" ]; then
        log "ERREUR : version distante injoignable après 30 tentatives"
        echo "Mise à jour impossible : version distante injoignable. Consulte $LOG"
        return 1
    fi
    if [[ ! "$remote" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        log "ERREUR : version distante invalide : $remote"
        echo "Mise à jour impossible : version distante invalide. Consulte $LOG"
        return 1
    fi

    if [ -f "$VERSION_FILE" ]; then
        if ! local_v="$(tr -d '\r\n[:space:]' < "$VERSION_FILE")"; then
            log "ERREUR : impossible de lire $VERSION_FILE"
            return 1
        fi
        if [[ ! "$local_v" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
            log "ERREUR : version locale invalide : $local_v"
            echo "Mise à jour impossible : version locale invalide. Consulte $LOG"
            return 1
        fi
    else
        local_v="0.0.0"
        log "version locale absente : installation initiale nécessaire"
    fi

    log "locale=$local_v distante=$remote"
    echo "Version installée : $local_v ; version distante : $remote"
    if ! version_gt "$remote" "$local_v"; then
        log "aucune mise à jour de l'intégration nécessaire"
        echo "Aucune mise à jour de l'intégration nécessaire."
        if ! run_logged bash "$LAUNCHER_UPDATER"; then
            log "ERREUR : échec de la mise à jour du launcher Quiver"
            echo "Échec de la mise à jour du launcher Quiver. Consulte $LOG"
            return 1
        fi
        return 0
    fi

    log "mise à jour vers $remote"
    echo "Mise à jour vers $remote..."
    if ! install_dir="$(mktemp -d /tmp/quiver-update.XXXXXX)"; then
        log "ERREUR : impossible de créer le dossier temporaire"
        return 1
    fi
    trap 'rm -rf -- "$install_dir"' EXIT

    if ! download_installer "$install_dir/install.sh"; then
        log "ERREUR : téléchargement de install.sh impossible"
        echo "Téléchargement de install.sh impossible. Consulte $LOG"
        return 1
    fi
    if ! run_logged bash "$install_dir/install.sh"; then
        log "ERREUR : échec de l'installation"
        echo "Échec de l'installation. Consulte $LOG"
        return 1
    fi
    log "mise à jour terminée"
    echo "Mise à jour terminée."
)

case "${1:-start}" in
    start)
        mkdir -p "$(dirname "$LOG")" || exit 1
        check_update background >> "$LOG" 2>&1 &
        ;;
    scan|update)
        mkdir -p "$(dirname "$LOG")" || exit 1
        check_update
        ;;
    status)
        if [ -f "$VERSION_FILE" ]; then
            cat "$VERSION_FILE"
        else
            echo "Version Quiver inconnue : $VERSION_FILE absent" >&2
            exit 1
        fi
        ;;
    stop) ;;
    *)
        echo "Usage : $0 {start|stop|status|scan|update}" >&2
        exit 1
        ;;
esac
