[Game]
name=Super Mario All Star USA
Folder=SuperMarioAllStars

[Launcher]
path=/userdata/system/Quiver/emulator/Apps/SuperMarioAllStars
executable=SuperMarioAllStars-Linux-x86_64.AppImage
args= --play

[Config]
setting_file=/userdata/system/configs/Quiver/data/SuperMarioAllStars/rompath.txt
preload_file=SNES_SMBALLSTARUSA.json

[Roms]
game_directory=/userdata/roms/quiver/GAME/SNES - Super Mario All Star USA
dlc_directory=/userdata/roms/quiver/DLC/NGC - Super Mario All Star USA
mods_directory=/userdata/roms/quiver/MODS/NGC - Super Mario All Star USA