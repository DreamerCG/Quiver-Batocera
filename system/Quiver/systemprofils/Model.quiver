[Game]
name=Super Mario Sunshine
Folder=TheLegendOfZeldaMajorasMask-2Ship2Harkinian

[Launcher]
path=/userdata/system/Quiver/emulator/Apps/
# clearcache=true supprime path/cache avant le lancement.
# path_cache permet de préciser un chemin relatif finissant par cache.
clearcache=false
# path_cache=user/cache
executable=SMS-Launcher.AppImage
args= --play

[Config]
setting_file= 
preload_file=

[Roms]
game_directory=/userdata/roms/quiver/GAME/N64 - Super Mario Sunshine
dlc_directory=/userdata/roms/quiver/DLC/NGC - Super Mario Sunshine
mods_directory=/userdata/roms/quiver/MODS/NGC - Super Mario Sunshine