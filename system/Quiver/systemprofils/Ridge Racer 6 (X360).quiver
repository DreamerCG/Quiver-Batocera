[Game]
name=Ridge Racer 6 (X360)
Folder=RidgeRacer6-RidgeRacer6Recompilation

[Launcher]
path=/userdata/system/Quiver/emulator/Apps/RidgeRacer6-RidgeRacer6Recompilation
executable=ridge-racer-6.sh
args= --play

[Config]
setting_file=
preload_file=

[Roms]
game_directory=/userdata/roms/quiver/GAME/XBOX360 - Ridge Racer 6
dlc_directory=/userdata/roms/quiver/DLC/XBOX360 - Ridge Racer 6
mods_directory=/userdata/roms/quiver/MODS/XBOX360 - Ridge Racer 6

[Command]
game_symlink_target=game_directory
game_symlink_name=game

dlc_symlink_target=dlc_directory
dlc_symlink_name=DLC